# SMTP (outreach agent + optional transactional email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@credoscreening.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=Tanver Afzal <your-email@credoscreening.com>

# IMAP (reply checker — defaults to SMTP creds + NetSol IMAP host)
IMAP_HOST=netsol-imap-oxcs.hostingplatform.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@credoscreening.com
IMAP_PASS=your-app-password

# Outreach agent (law firm / Trusted Signatures campaigns)
OUTREACH_FROM_EMAIL=Kristina <Kristina@credoscreening.com>
OUTREACH_REPLY_TO=Kristina@credoscreening.com
OUTREACH_BCC=your-personal@gmail.com
OUTREACH_SENDER_NAME=Kristina
