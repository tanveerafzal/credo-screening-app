# SMTP — contact form sends as Tanveer@trustcredo.com through Purelymail.
# Port 465 is implicit TLS. Do not leave the old Network Solutions host in place.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Tanveer@trustcredo.com
SMTP_PASS=your-purelymail-password
SMTP_FROM_EMAIL=Credo Screening <Tanveer@trustcredo.com>
CONTACT_EMAIL=sales@credoscreening.com

# IMAP (reply checker — Purelymail)
IMAP_HOST=imap.purelymail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=Tanveer@trustcredo.com
IMAP_PASS=your-purelymail-password

# Outreach agent (law firm / Trusted Signatures campaigns)
OUTREACH_FROM_EMAIL=Kristina <Kristina@credoscreening.com>
OUTREACH_REPLY_TO=Kristina@credoscreening.com
OUTREACH_BCC=your-personal@gmail.com
OUTREACH_SENDER_NAME=Kristina
