# API URL for backend services (login, register, screening, etc.)
NEXT_PUBLIC_API_URL=https://id-verify-api-test-214036150009.northamerica-northeast2.run.app

# Server-side proxy target for /api/partners/* (register, login). Overrides NEXT_PUBLIC_API_URL.
# ID_VERIFY_API_URL=https://id-verify-api-test-214036150009.northamerica-northeast2.run.app

# Dashboard URL (where users are redirected after login/register)
NEXT_PUBLIC_ID_VERIFY_BACKEND=https://partner-test.trustcredo.com

# Resend (contact form on website)
RESEND_API_KEY=
CONTACT_EMAIL=sales@trustcredo.com

# SMTP (outreach agent + optional transactional email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@trustcredo.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=Tanver Afzal <your-email@trustcredo.com>

# IMAP (reply checker — defaults to SMTP creds + NetSol IMAP host)
IMAP_HOST=netsol-imap-oxcs.hostingplatform.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@trustcredo.com
IMAP_PASS=your-app-password

# Outreach agent (law firm / Trusted Signatures campaigns)
OUTREACH_FROM_EMAIL=Kristina <Kristina@trustcredo.com>
OUTREACH_REPLY_TO=Kristina@trustcredo.com
OUTREACH_BCC=your-personal@gmail.com
OUTREACH_SENDER_NAME=Kristina
